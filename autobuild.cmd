set LF=^


set "TOK=__%RANDOM%%RANDOM%%RANDOM%%RANDOM%__"
set "MS=%TOK%MS_"

set "%MS%COMPILER=cl.exe"
set "%MS%COMPILER_LIKE=msvc"
set "%MS%FIRST_COMPILER_ARGS="
set "%MS%COMPILER_INPUT_FILE_PREFIX="
set "%MS%COMPILER_OUTPUT_FILE_PREFIX=-o "
set "%MS%LAST_COMPILER_ARGS="
set "%MS%TEMP=temp"
set "%MS%BIN=bin"
set "%MS%RESOURCE_COMPILER=rc.exe"
set "%MS%FIRST_RESOURCE_ARGS="
set "%MS%MIDDLE_RESOURCE_ARGS="
set "%MS%LAST_RESOURCE_ARGS="
set "%MS%RESOURCE_INPUT_FILE="
set "%MS%RESOURCE_OUTPUT_FILE="
set "%MS%MIDDLE_COMPILER_ARGS="
set "%MS%RESOURCE_INPUT_FILE_PREFIX="
set "%MS%RESOURCE_OUTPUT_FILE_PREFIX="
set "%MS%RESOURCE_EXTENSION=.res"
set "%MS%RESOURCE_INPUT_FILE_FIRST=TRUE"
set "%MS%BITS=64"
set "%MS%OS=%OS%"
set "COMMANDS="
set "%MS%ARCH=%PROCESSOR_ARCHITECTURE%"
set "%MS%ECHO=echo"

set "%MS%SAVE=FALSE"
set "%MS%ERROR=FALSE"
set "CONFIGURED="

set "%MS%CD=%CD%"

set "%MS%SPACE= "
set "%MS%NEW_LINE=!LF!"

set "CONFIGFILE=Autobuild"
set "PREFS=!%MS%CD!\Autobuild.save.cmd"
set "GENERATED_MESSAGE=Generated by Autobuild v1.0.0"

set "%MS%ARGC=0"
for %%Q in (%*) do (
	set "%MS%ARG!%MS%ARGC!=%%Q"
	set /a %MS%ARGC+=1
)

if exist "%PREFS%" goto RunPrefs

:ConfigAuto
set "CONDITION=0"
set "ENDS=0"
set "CURRENT_LINE=0"
for /f "usebackq tokens=1,2,3,* delims= " %%A in ("%CONFIGFILE%") do (
	set /a CURRENT_LINE+=1
	set "RESULT=TRUE"
	if "%%A"=="IF" (
		set "RESULT=TRUE"
		set "ISIF=TRUE"
		set "ISELSE=FALSE"
		set "LAST_WAS_IF=1"
	) else if "%%A"=="ELSEIF" (
		set "ISELSE=TRUE"
		set "ISIF=TRUE"
		set "RESULT=TRUE"
	) else if "%%A"=="ELSE" (
		set "ISELSE=TRUE"
		set "ISIF=FALSE"
		set "RESULT=TRUE"
	) else (
		set "ISELSE=FALSE"
		set "RESULT=FALSE"
		set "ISIF=FALSE"
	)
	if "!RESULT!"=="TRUE" (
		if "!ISIF!"=="TRUE" (
			set "SIGN=%%C"
			set "VALUE=%%D"
			if "!SIGN!"=="=" (
				if "!%MS%%%B!"=="!VALUE!" (
					set "RESULT=TRUE"
				) else (
					set "RESULT=FALSE"
				)
			) else if "!SIGN!"=="~=" (
				if /i not "!%MS%%%B!"=="!VALUE!" (
					set "RESULT=TRUE"
				) else (
					set "RESULT=FALSE"
				)
			)
			if "!RESULT!"=="TRUE" (
				if /i not "!CONDITION!"=="0" (
					if /i not "%%A"=="IF" (
						if "!ENDS!"=="0" if "!CONDITION!"=="1" (
							set "LAST_WAS_IF=1"
							set /a CONDITION-=1
						)
					) else (
						set /a CONDITION+=1
					)
				) else if "!CONDITION!"=="0" (
					if /i not "%%A"=="IF" (
						set "LAST_WAS_IF=0"
						set /a CONDITION+=1
						set /a ENDS+=1
					)
				)
			) else (
				if /i not "!CONDITION!"=="0" (
					if "%%A"=="IF" (
						set /a CONDITION+=1
					)
				) else if "!CONDITION!"=="0" (
					if /i not "%%A"=="IF" (
						set "LAST_WAS_IF=0"
						set /a CONDITION+=1
						set /a ENDS+=1
					) else (
						set /a CONDITION+=1
					)
				)
			)
		) else if "!ISELSE!"=="TRUE" (
			if "!CONDITION!"=="1" (
				if "!ENDS!"=="0" (
					set "LAST_WAS_IF=1"
					set /a CONDITION-=1
				)
			) else if "!CONDITION!"=="0" (
				set /a ENDS+=1
				set /a CONDITION+=1
				set "LAST_WAS_IF=0"
			)
		)
	)
	if "%%A"=="END" (
		if /i not "!CONDITION!"=="0" set /a CONDITION-=1
		if /i not "!LAST_WAS_IF!"=="1" if /i not "!ENDS!"=="0" set /a ENDS-=1
	)
	if "!CONDITION!"=="0" (
		if "%%A"=="VAR" (
			if "%%C"=="=" (
				set "%MS%%%B=%%D"
			) else if "%%C"=="+=" (
				set /a "%MS%%%B+=%%D"
			) else if "%%C"=="-=" (
				set /a "%MS%%%B-=%%D"
			) else if "%%C"=="*=" (
				set /a "%MS%%%B*=%%D"
			) else if "%%C"=="/=" (
				set /a "%MS%%%B/=%%D"
			) else (
				set "%MS%%%B="
			)
		) else if "%%A"=="GET" (
			if "%%B"=="ENV" (
				set "%MS%%%C=%%%%D%%"
			) else if "%%B"=="INPUT" (
				set /p %MS%%%C="%%D"
			)
		) else if "%%A"=="SET" (
			if "%%B"=="ENV" (
				set "%%C=!%MS%%%D!"
			)
		) else if "%%A"=="PRINT" (
			set "PRINT_STUFF=%%B %%C %%D"
			echo(!PRINT_STUFF!
		)
	)
	if !CONDITION! equ 0 (
		set "LINE_!CURRENT_LINE!=1"
	)
)
set "CURRENT_LINE=0"
for /f "usebackq tokens=1,2,* delims= " %%A in ("%CONFIGFILE%") do (
	set /a CURRENT_LINE+=1
	set "THIS_LINE=LINE_!CURRENT_LINE!"
)
set "CURRENT_LINE=0"
set "LAST_WAS_LABEL=0"
for /f "usebackq tokens=1,* delims= " %%A in ("%CONFIGFILE%") do (
	set /a CURRENT_LINE+=1
	set "THIS_LINE=LINE_!CURRENT_LINE!"
	if defined !THIS_LINE! (
		if "%%A"=="COMMAND" (
			for %%W in (%%B) do (
				if defined %MS%%%W (
					set "COMMANDS=!COMMANDS!!%MS%%%W!"
				) else if defined %MS%%%W (
					set "COMMANDS=!COMMANDS!!%MS%%%W!"
				)
			)
			set "COMMANDS=!COMMANDS!!LF!"
			set "LAST_WAS_LABEL=0"
		) else if "%%A"=="MODES" (
			if "!LAST_WAS_LABEL!"=="0" set "COMMANDS=!COMMANDS!goto %TOK%end%TOK%!LF!"
			for %%W in (%%B) do (
				set "JUMPS=!JUMPS!if "%%~1"=="%%W" goto %%W!LF!"
				set "COMMANDS=!COMMANDS!:%%W!LF!"
			)
			set "JUMPS=!JUMPS!!LF!"
			set "COMMANDS=!COMMANDS!!LF!"
			set "LAST_WAS_LABEL=1"
		) else if "%%A"=="MODE" (
			if "!LAST_WAS_LABEL!"=="0" set "COMMANDS=!COMMANDS!goto %TOK%end%TOK%!LF!"
			set "JUMPS=!JUMPS!if "%%~1"=="%%B" goto %%B!LF!"
			set "COMMANDS=!COMMANDS!:%%B!LF!"
			set "LAST_WAS_LABEL=1"
		) else (
			set "LAST_WAS_LABEL=0"
		)
	)
)
set "CONFIGURED=1"
goto Setup

:Usage
echo Usage: %~nx0 {clean^|reset^|config <file.conf>}
exit /b 2


if /i "%~1"=="reset" del "%PREFS%" 2>nul
if /i not "!%MS%SAVE!"=="TRUE" goto MakeScriptVolatile
if not exist "%PREFS%" goto MakeScript
:Setup
set "RETURN_ADDRESS=1"
goto DumpCode
:ReturnAddress1
if /i not "!%MS%SAVE!"=="TRUE" (
	"%PREFS%" && if /i not "%*"=="" "%PREFS%" %* && del "%PREFS%"
) else (
	"%PREFS%" && if /i not "%*"=="" "%PREFS%" %*
)
goto eexit

:CleanPrefs
:RunPrefs
"%PREFS%" %*
goto eexit

:MakeScriptVolatile
set "RETURN_ADDRESS=2"
goto DumpCode
:ReturnAddress2
::start /b "" cmd /c del "%%THISFILE%%"^&exit /b
"%PREFS%" && if /i not "%*"=="" "%PREFS%" %* && del "%PREFS%"
goto eexit

:MakeScript
set "RETURN_ADDRESS=3"
goto DumpCode
:ReturnAddress3
"%PREFS%" && if /i not "%*"=="" "%PREFS%" %*
goto eexit

:DumpCode
>"%PREFS%" echo(@echo off
>>"%PREFS%" echo(::%GENERATED_MESSAGE%
>>"%PREFS%" echo(set "THISFILE=%%~f0"
>>"%PREFS%" echo(:%TOK%start%TOK%
>>"%PREFS%" echo(!JUMPS!
>>"%PREFS%" echo(if "%%%TOK%main_entered%TOK%%%"=="1" goto %TOK%end%TOK%
>>"%PREFS%" echo(!COMMANDS!
>>"%PREFS%" echo(:%TOK%end%TOK%
>>"%PREFS%" echo(if "%%~1"=="" goto %TOK%full_end%TOK%
>>"%PREFS%" echo(set "%TOK%main_entered%TOK%=1"
>>"%PREFS%" echo(shift
>>"%PREFS%" echo(set "%TOK%main_entered%TOK%=1"
>>"%PREFS%" echo(goto %TOK%start%TOK%
>>"%PREFS%" echo(:%TOK%full_end%TOK%
>>"%PREFS%" echo(if "%%%TOK%main_entered%TOK%%%"=="0" goto %TOK%end%TOK%
if "%RETURN_ADDRESS%"=="1" goto ReturnAddress1
if "%RETURN_ADDRESS%"=="2" goto ReturnAddress2
if "%RETURN_ADDRESS%"=="3" goto ReturnAddress3
:eexit
